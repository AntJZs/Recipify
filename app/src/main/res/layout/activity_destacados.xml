<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_surface"
    tools:context=".Destacados">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero con botones -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="280dp">

                <ImageView
                    android:id="@+id/ivHero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@color/md_theme_surface"
                    android:src="@drawable/destacados" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/gradient_overlay" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Destacados"
                        android:textAppearance="?attr/textAppearanceDisplaySmall"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¡Descubre y comparte recetas deliciosas!"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="@color/md_theme_primaryFixed"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRegistrarse"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginEnd="12dp"
                            android:text="Registrarse"
                            android:textColor="@color/md_theme_surfaceVariant"
                            app:cornerRadius="24dp"
                            app:icon="@drawable/front_hand_24px"
                            app:iconTint="@color/md_theme_surfaceVariant" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnIniciarSesion"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:text="Iniciar sesión"
                            android:textColor="@color/md_theme_onSurface"
                            app:cornerRadius="24dp"
                            app:backgroundTint="@color/md_theme_surfaceContainerLow"
                            app:icon="@drawable/account_circle_24px"
                            app:iconTint="@color/md_theme_onSurface"
                            app:strokeColor="@color/md_theme_surfaceContainerLow"
                            app:strokeWidth="1dp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Recetas destacadas -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <!-- Receta 1 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_toStartOf="@+id/ivReceta1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="Truffle Risotto"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorOnSurface"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <com.google.android.material.chip.Chip
                                    style="@style/Widget.Material3.Chip.Suggestion"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:text="Entrada"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    app:chipBackgroundColor="?attr/colorSurface"
                                    app:chipMinHeight="32dp"
                                    app:chipStrokeColor="?attr/colorOutline"
                                    app:chipStrokeWidth="1dp" />

                                <com.google.android.material.chip.Chip
                                    style="@style/Widget.Material3.Chip.Suggestion"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Cremoso"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    app:chipBackgroundColor="?attr/colorSurface"
                                    app:chipMinHeight="32dp"
                                    app:chipStrokeColor="?attr/colorOutline"
                                    app:chipStrokeWidth="1dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivReceta1"
                            android:layout_width="100dp"
                            android:layout_height="80dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="?attr/colorSurfaceContainerHigh"
                            android:scaleType="centerCrop"
                            android:src="@drawable/input_page_02"
                            android:contentDescription="Truffle Risotto" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- Receta 2 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_toStartOf="@+id/ivReceta2"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="Tacos de Pollo"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorOnSurface"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <com.google.android.material.chip.Chip
                                    style="@style/Widget.Material3.Chip.Suggestion"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:text="Principal"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    app:chipBackgroundColor="?attr/colorSurface"
                                    app:chipMinHeight="32dp"
                                    app:chipStrokeColor="?attr/colorOutline"
                                    app:chipStrokeWidth="1dp" />

                                <com.google.android.material.chip.Chip
                                    style="@style/Widget.Material3.Chip.Suggestion"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="30 min"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    app:chipBackgroundColor="?attr/colorSurface"
                                    app:chipMinHeight="32dp"
                                    app:chipStrokeColor="?attr/colorOutline"
                                    app:chipStrokeWidth="1dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivReceta2"
                            android:layout_width="100dp"
                            android:layout_height="80dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="?attr/colorSurfaceContainerHigh"
                            android:scaleType="centerCrop"
                            android:src="@drawable/input_page_01"
                            android:contentDescription="Tacos de Pollo" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- Receta 3 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_toStartOf="@+id/ivReceta3"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="Pasta Carbonara"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorOnSurface"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <com.google.android.material.chip.Chip
                                    style="@style/Widget.Material3.Chip.Suggestion"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:text="Pasta"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    app:chipBackgroundColor="?attr/colorSurface"
                                    app:chipMinHeight="32dp"
                                    app:chipStrokeColor="?attr/colorOutline"
                                    app:chipStrokeWidth="1dp" />

                                <com.google.android.material.chip.Chip
                                    style="@style/Widget.Material3.Chip.Suggestion"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="20 min"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    app:chipBackgroundColor="?attr/colorSurface"
                                    app:chipMinHeight="32dp"
                                    app:chipStrokeColor="?attr/colorOutline"
                                    app:chipStrokeWidth="1dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivReceta3"
                            android:layout_width="100dp"
                            android:layout_height="80dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="?attr/colorSurfaceContainerHigh"
                            android:scaleType="centerCrop"
                            android:src="@drawable/input_page_02"
                            android:contentDescription="Pasta Carbonara" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <!-- Receta 4 -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainerLowest"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_toStartOf="@+id/ivReceta4"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:text="Sopa de Tomate"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textColor="?attr/colorOnSurface"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <com.google.android.material.chip.Chip
                                    style="@style/Widget.Material3.Chip.Suggestion"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="8dp"
                                    android:text="Sopa"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    app:chipBackgroundColor="?attr/colorSurface"
                                    app:chipMinHeight="32dp"
                                    app:chipStrokeColor="?attr/colorOutline"
                                    app:chipStrokeWidth="1dp" />

                                <com.google.android.material.chip.Chip
                                    style="@style/Widget.Material3.Chip.Suggestion"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="15 min"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    app:chipBackgroundColor="?attr/colorSurface"
                                    app:chipMinHeight="32dp"
                                    app:chipStrokeColor="?attr/colorOutline"
                                    app:chipStrokeWidth="1dp" />
                            </LinearLayout>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivReceta4"
                            android:layout_width="100dp"
                            android:layout_height="80dp"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="?attr/colorSurfaceContainerHigh"
                            android:scaleType="centerCrop"
                            android:src="@drawable/input_page_01"
                            android:contentDescription="Sopa de Tomate" />
                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
